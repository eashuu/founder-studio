---
import Brutal from '../../layouts/Brutal.astro';
import { slots, slotsIn, track, stage, costKey, verdictLabel, editUrl, shortName, REPO_LIVE, wbr, tornStrip } from '../../lib/data.js';

export function getStaticPaths() {
  return slots.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const p = s.pick;
const t = track(s.track);
const v = s.verify?.verdict;
const good = v === 'ok' || v === 'fixed';
const show = (x) => x && x !== 'n/a' && x !== 'unclear';
const facts = [
  ['Cost', p.cost], ['Pricing', p.free_limits], ['Commercial use', p.commercial_ok], ['Platforms', p.platforms],
  ['Licence', p.license], ['Maintained', p.maintained],
].filter(([, x]) => show(x));
const bf = s.best_free;
const bfInstall = bf?.install && !/^web$/i.test(bf.install);
const regions = Object.entries(s.region_notes || {});
const oses = Object.entries(s.os_notes || {});
const hasInstall = p.install && !/^web$/i.test(p.install);
const sib = slotsIn(s.track);
const at = sib.indexOf(s);
const prev = sib[at - 1];
const next = sib[at + 1];
const no = String(slots.indexOf(s) + 1).padStart(3, '0');
const key = (n) => shortName(n).toLowerCase();
const pickKey = key(p.name);
const altKeys = new Set([...s.alts, ...(bf ? [bf] : [])].map((a) => key(a.name)));
const isPick = (n) => /\(pick\)/i.test(n) || key(n) === pickKey || key(n).startsWith(pickKey);
---
<Brutal title={`${shortName(p.name)}: ${s.slot}`} description={`${p.name}: ${p.what}`}>
  <div class="wrap">
    <div class="spec-top cap">
      <span><a href="/" data-scramble>Index</a><span class="sl">/</span><a href={`/#${t.stage}`}>{stage(t.stage).name}</a><span class="sl">/</span><a href={`/tracks/${t.key}/`} data-scramble>{t.name}</a><span class="sl">/</span>No. {no}</span>
      <span>{s.slot}<span class="sl">/</span>Checked {p.checked}</span>
    </div>

    <section class="spec-hero">
      <div>
        <span class="cap" style="color:var(--blue)">Best overall</span>
        <h1 class="display">{shortName(p.name)}</h1>
        {shortName(p.name) !== p.name && <p class="cap" style="margin-top:14px">{p.name}</p>}
        <p class="what" set:html={wbr(p.what)} />
        {p.why && <p class="why" set:html={wbr(p.why)} />}
        {hasInstall && <div class="cmd"><code>{p.install}</code><button type="button" data-copy={p.install}>Copy</button></div>}
        <div class="actions">
          <button class="btn blue" type="button" data-add={s.slug} data-name={p.name} data-slot={s.slot}>+ Add to stack</button>
          <a class="btn" href={p.url || p.source_url}>Website ↗</a>
          <a class="btn" href={p.source_url}>Source ↗</a>
        </div>
      </div>
      <div class="keyfacts" role="group" aria-label="Key facts">
        <div class={`stamp ${good ? '' : 'warn'}`}>{verdictLabel(v)}<small>{good ? 'Primary source' : 'Needs a check'} · {p.checked}</small></div>
        <dl class="facts">{facts.map(([k, x]) => <div><dt>{k}</dt><dd>{x}</dd></div>)}</dl>
      </div>
    </section>

    {bf && (
      <section class="free" aria-label="Best free option" style={`clip-path:${tornStrip(s.slug)}`}>
        <span class="cap">Best free option</span>
        <div class="free-body">
          <div>
            <h2 class="display">{shortName(bf.name)}</h2>
            <p set:html={wbr(bf.what)} />
            {show(bf.free_limits) && <p class="cap free-limits">{bf.free_limits}</p>}
          </div>
          <div class="free-act">
            {bfInstall && <div class="cmd"><code>{bf.install}</code><button type="button" data-copy={bf.install}>Copy</button></div>}
            <div class="actions">
              <button class="btn" type="button" data-add={`${s.slug}--free`} data-name={bf.name} data-slot={`${s.slot} (free)`}>+ Add to stack</button>
              <a class="btn" href={bf.url || bf.source_url}>Website ↗</a>
            </div>
          </div>
        </div>
      </section>
    )}

    {(s.decision || s.note) && (
      <section class="block">
        <div class="block-h"><h2>Why this</h2><span class="cap">Decision</span></div>
        {s.decision && <p class="lede">{s.decision}</p>}
        {s.note && <div class="slip">{s.note}</div>}
        {s.details && <p class="why" style="max-width:70ch;margin-top:22px">{s.details}</p>}
      </section>
    )}

    {(regions.length > 0 || oses.length > 0) && (
      <section class="block two">
        {oses.length > 0 && <div>
          <div class="block-h"><h2>By OS</h2><span class="cap">Platform notes</span></div>
          <dl class="notes-list">{oses.map(([k, x]) => <div><dt>{k}</dt><dd set:html={wbr(x)} /></div>)}</dl>
        </div>}
        {regions.length > 0 && <div>
          <div class="block-h"><h2>By country</h2><span class="cap">Where it differs</span></div>
          <dl class="notes-list">{regions.map(([k, x]) => <div><dt>{k}</dt><dd set:html={wbr(x)} /></div>)}</dl>
        </div>}
      </section>
    )}

    {s.alts.length > 0 && (
      <section class="block">
        <div class="block-h"><h2>Head to head</h2><span class="cap">Best overall, best free, runners-up</span></div>
        <div class="tbl">
          <table>
            <thead><tr><th>Option</th><th>What it is</th><th>When it wins</th><th>Cost</th></tr></thead>
            <tbody>
              {[{ ...p, tag: 'Best overall' }, ...(bf ? [{ ...bf, tag: 'Best free' }] : []), ...s.alts].map((a, i) => (
                <tr class={i === 0 ? 'is-pick' : a.tag ? 'is-free' : ''}>
                  <td><a href={a.url || a.source_url} style="text-decoration:none"><span class="nm">{shortName(a.name)}</span></a>{a.tag && <small style="color:var(--blue)">{a.tag}</small>}</td>
                  <td set:html={wbr(a.what)} />
                  <td set:html={wbr(a.why)} />
                  <td>{costKey(a.cost)}{show(a.free_limits) && <small>{a.free_limits}</small>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {s.candidates.length > 0 && (
      <section class="block">
        <div class="block-h"><h2>The graveyard</h2><span class="cap">{s.candidates.length} options considered</span></div>
        <ul class="grave">
          {s.candidates.map((c) => (
            <li class={isPick(c.name) ? 'won' : altKeys.has(key(c.name)) ? '' : 'lost'}><b>{c.name}</b><span>{c.verdict}</span></li>
          ))}
        </ul>
      </section>
    )}

    <section class="block two">
      <div>
        <div class="block-h"><h2>Verification</h2><span class="cap">{verdictLabel(v)}</span></div>
        <p class="why" style="max-width:62ch;color:var(--ink)">{s.verify?.note || 'This slot has not been independently verified yet.'}</p>
        {s.verify?.url && <p class="cap" style="margin-top:12px"><a href={s.verify.url}>Evidence ↗</a></p>}
        {s.better_pick && <div class="slip">The verifier suggests <a href={s.better_pick.url}>{s.better_pick.name}</a>: {s.better_pick.reason}</div>}
      </div>
      <div>
        <div class="block-h"><h2>Fix it</h2><span class="cap">Open data</span></div>
        <p class="why" style="color:var(--ink)">Prices and free tiers change. If something here is out of date, {REPO_LIVE ? "edit this slot's data file and include a source link." : 'corrections open when the source repository goes public.'}</p>
        {REPO_LIVE && <a class="btn" style="margin-top:14px" href={editUrl(s.slug)}>Suggest an edit ↗</a>}
      </div>
    </section>

    <nav class="pager" aria-label="More in this track">
      {prev ? <a href={`/tools/${prev.slug}/`}><span class="cap">← Previous in {t.name}</span><b>{shortName(prev.pick.name)}</b></a>
            : <a class="end" href={`/tracks/${t.key}/`}><span class="cap">First in {t.name}</span><b>All {sib.length} slots</b></a>}
      {next ? <a href={`/tools/${next.slug}/`}><span class="cap">Next in {t.name} →</span><b>{shortName(next.pick.name)}</b></a>
            : <a class="end" href={`/tracks/${t.key}/`}><span class="cap">Last in {t.name}</span><b>Back to the track</b></a>}
    </nav>
  </div>
</Brutal>
