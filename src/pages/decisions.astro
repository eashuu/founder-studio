---
import Brutal from '../layouts/Brutal.astro';
import { meta } from '../lib/data.js';
const lvl = { high: 'Read first', med: 'Important', low: 'Good to know' };
---
<Brutal title="Decisions" description="Calls made where research tracks overlapped, and security notes for a solo founder's setup.">
  <div class="wrap page">
    <header class="ph">
      <h1 class="display">Decisions</h1>
      <div><p>Where two tracks picked different tools for the same job, or verification changed the advice, one call was made so the stack fits together.</p><span class="cap">{meta.decisions.length} case files<span class="sl">/</span>{meta.notes.length} security notes</span></div>
    </header>

    <div class="cases">
      {meta.decisions.map((d, i) => (
        <article class="case">
          <span class="tab cap">Case {String(i + 1).padStart(2, '0')}</span>
          <span class="decided" aria-hidden="true">Decided</span>
          <h2>{d.title}</h2>
          <p>{d.body}</p>
          {d.url && <p class="cap" style="margin-top:12px"><a href={d.url}>Source ↗</a></p>}
        </article>
      ))}
    </div>

    <section class="hazard">
      <div class="hazard-h"><h2>Before you install</h2></div>
      {meta.notes.map((n) => (
        <div class="note">
          <span class={`lvl ${n.sev === 'high' ? 'high' : ''}`}>{lvl[n.sev]}</span>
          <div><h3>{n.title}</h3><p>{n.body}</p></div>
        </div>
      ))}
    </section>
  </div>
</Brutal>
