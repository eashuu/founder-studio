---
import Base from '../layouts/Base.astro';
import Tear from '../components/Tear.astro';
import { slots, track } from '../lib/data.js';
const index = slots.map((s) => ({
  u: `/tools/${s.slug}/`, n: s.pick.name, s: s.slot, t: track(s.track).name,
  h: [s.slot, s.pick.name, s.pick.what, ...s.alts.map((a) => a.name), ...s.candidates.map((c) => c.name)].join(' ').toLowerCase(),
}));
---
<Base title="Search" description="Search every slot, pick and alternative.">
  <section class="sheet grain page-head">
    <span class="label">Search</span>
    <h1>Find a tool or a job</h1>
    <p>Search slots, picks, runners-up and every option that was compared.</p>
    <div class="tools-bar"><input type="search" id="q" placeholder="e.g. payments, Expo, vector store" aria-label="Search" autocomplete="off" /></div>
    <ul class="results" id="results"></ul>
    <noscript><p>Search needs JavaScript. Browse the <a href="/tracks/">tracks</a> instead.</p></noscript>
    <Tear seed="search" side="bottom" />
  </section>
  <script type="application/json" id="idx" set:html={JSON.stringify(index)} />
  <script>
    type Row = { u: string; n: string; s: string; t: string; h: string };
    const idx: Row[] = JSON.parse(document.getElementById('idx')!.textContent || '[]');
    const q = document.getElementById('q') as HTMLInputElement;
    const out = document.getElementById('results')!;
    const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    function run() {
      const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const hits = words.length ? idx.filter((r) => words.every((w) => r.h.includes(w))).slice(0, 60) : [];
      out.innerHTML = words.length && !hits.length
        ? '<li><span>No match. Try a broader word, such as "email" or "hosting".</span></li>'
        : hits.map((r) => `<li><a href="${r.u}"><b>${esc(r.n)}</b><span>${esc(r.s)} · ${esc(r.t)}</span></a></li>`).join('');
      history.replaceState(null, '', words.length ? `?q=${encodeURIComponent(q.value)}` : location.pathname);
    }
    q.value = new URLSearchParams(location.search).get('q') || '';
    q.addEventListener('input', run);
    run();
    q.focus();
  </script>
</Base>
