---
import Brutal from '../layouts/Brutal.astro';
---
<Brutal title="Not found">
  <section class="wrap torn404">
    <div>
      <h1 class="display">404</h1>
      <p class="cap" style="margin-top:18px">This page was torn out<span class="sl">/</span>The link may be old</p>
      <p style="margin-top:22px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap"><button class="btn solid" type="button" data-palette>Search instead</button><a class="btn" href="/">Back to the index</a></p>
    </div>
  </section>
</Brutal>
