---
import '../styles/brutal.css';
import { REPO, meta, slots, track, shortName, tearPath } from '../lib/data.js';
const { title, description = 'Every tool a solo AI founder needs, from problem to paid, on free tiers: picked, compared and verified.' } = Astro.props;
const path = Astro.url.pathname;
const full = title ? `${title} / Founder Studio` : 'Founder Studio';
const nav = [['/tracks/', 'Tracks'], ['/playbook/', 'Playbook'], ['/decisions/', 'Decisions'], ['/method/', 'Method']];
const index = slots.map((s) => ({ u: `/tools/${s.slug}/`, n: shortName(s.pick.name), s: s.slot, t: track(s.track).name,
  h: [s.slot, s.pick.name, ...s.alts.map((a) => a.name), ...s.candidates.map((c) => c.name)].join(' ').toLowerCase() }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=tanker@400&f[]=general-sans@400,500,600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&display=swap" />
    <script is:inline src="/tear.js"></script>
  </head>
  <body>
    <header class="bar">
      <div class="wrap">
        <a class="logo" href="/">Founder<i>/</i>Studio</a>
        <nav aria-label="Main">
          {nav.map(([href, label]) => <a href={href} data-scramble aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <button class="btn" type="button" data-palette>Search <kbd class="hide-s">Ctrl K</kbd></button>
        <button class="btn solid" type="button" data-drawer>Stack <span class="count" data-count>0</span></button>
      </div>
    </header>

    <main><slot /></main>

    <footer class="foot">
      <svg class="rip" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><path d={tearPath('foot', 'bottom', 60)} /></svg>
      <div class="wrap">
        <div class="row cap">
          <span>Checked {meta.built}<span class="sl">/</span>Prices and free tiers change. Check before you pay.</span>
          <span><a href={REPO}>Source and corrections on GitHub</a><span class="sl">/</span><a href="/method/">Method</a></span>
        </div>
        <svg class="word" viewBox="0 0 1000 156" aria-hidden="true"><text x="0" y="150" font-size="196" textLength="1000" lengthAdjust="spacingAndGlyphs">FOUNDER<tspan class="b">/</tspan>STUDIO</text></svg>
      </div>
    </footer>

    <dialog class="palette" aria-label="Search">
      <input type="text" placeholder="Search 245 slots" aria-label="Search tools and slots" autocomplete="off" />
      <ul role="listbox"></ul>
      <div class="hint cap">↑ ↓ to move<span class="sl">/</span>Enter to open<span class="sl">/</span>Esc to close</div>
    </dialog>

    <aside class="drawer" aria-label="Your stack">
      <header><h2>Your stack</h2><button class="btn" type="button" data-drawer-close>Close</button></header>
      <ol></ol>
      <footer>
        <button class="btn solid" type="button" data-md-copy>Copy Markdown</button>
        <button class="btn" type="button" data-md-dl>Download .md</button>
      </footer>
    </aside>
    <div class="drawer-shade" data-drawer-close></div>

    <script type="application/json" id="fs-index" set:html={JSON.stringify(index)} />
    <script>
      const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as HTMLElement;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scrambled text on hover (nav links, captions marked data-scramble)
      const glyphs = '!<>-_\\/[]{}=+*^?#ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
        const text = el.textContent || '';
        let raf = 0;
        el.addEventListener('mouseenter', () => {
          if (reduce) return;
          let f = 0;
          cancelAnimationFrame(raf);
          const tick = () => {
            el.textContent = [...text].map((c, i) => (i < f / 2 || c === ' ' ? c : glyphs[(Math.random() * glyphs.length) | 0])).join('');
            if (f++ < text.length * 2) raf = requestAnimationFrame(tick); else el.textContent = text;
          };
          tick();
        });
      });

      // Split-flap counters
      document.querySelectorAll<HTMLElement>('[data-flap]').forEach((el) => {
        const target = el.dataset.flap || '';
        const render = (s: string) => (el.innerHTML = [...s].map((c) => `<span class="${/\d/.test(c) ? '' : 'c'}">${c}</span>`).join(''));
        if (reduce) return render(target);
        let step = 0;
        const id = setInterval(() => {
          render([...target].map((c, i) => (/\d/.test(c) && step < 10 + i * 4 ? String((Math.random() * 10) | 0) : c)).join(''));
          if (++step > 10 + target.length * 4) { clearInterval(id); render(target); }
        }, 45);
      });

      // Marquee speeds up with scroll velocity
      const track = $('.ticker .track');
      const anim = track?.getAnimations()[0];
      if (anim && !reduce) {
        let last = scrollY, rate = 1;
        addEventListener('scroll', () => { rate = Math.min(6, 1 + Math.abs(scrollY - last) / 12); last = scrollY; anim.playbackRate = rate; }, { passive: true });
        setInterval(() => { rate = Math.max(1, rate * 0.9); anim.playbackRate = rate; }, 80);
      }

      // Command palette
      const idx: { u: string; n: string; s: string; t: string; h: string }[] = JSON.parse($('#fs-index').textContent || '[]');
      const dlg = $('dialog.palette') as HTMLDialogElement;
      const input = $('input', dlg) as HTMLInputElement;
      const list = $('ul', dlg);
      let sel = 0;
      const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      const results = () => {
        const w = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        return (w.length ? idx.filter((r) => w.every((x) => r.h.includes(x))) : idx).slice(0, 40);
      };
      const draw = () => {
        const r = results();
        sel = Math.min(sel, Math.max(0, r.length - 1));
        list.innerHTML = r.length
          ? r.map((x, i) => `<li><a href="${x.u}" aria-selected="${i === sel}"><span><b>${esc(x.n)}</b> · ${esc(x.s)}</span><span class="cap">${esc(x.t)}</span></a></li>`).join('')
          : '<li class="hint cap">No match. Try a broader word, such as email or hosting.</li>';
        list.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' });
      };
      const openPalette = () => { input.value = ''; sel = 0; draw(); dlg.showModal(); input.focus(); };
      input.addEventListener('input', () => { sel = 0; draw(); });
      input.addEventListener('keydown', (e) => {
        const n = list.querySelectorAll('a').length;
        if (e.key === 'ArrowDown') { sel = (sel + 1) % Math.max(n, 1); draw(); e.preventDefault(); }
        if (e.key === 'ArrowUp') { sel = (sel - 1 + n) % Math.max(n, 1); draw(); e.preventDefault(); }
        if (e.key === 'Enter') (list.querySelector('[aria-selected="true"]') as HTMLAnchorElement)?.click();
      });
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      addEventListener('keydown', (e) => {
        const typing = /input|textarea/i.test((e.target as HTMLElement).tagName);
        if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) { e.preventDefault(); openPalette(); }
      });
      document.querySelectorAll('[data-palette]').forEach((b) => b.addEventListener('click', openPalette));

      // Stack drawer (saved in this browser only)
      const KEY = 'founder-studio-stack';
      type Item = { slug: string; name: string; slot: string };
      let stack: Item[] = [];
      try { stack = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch {}
      const drawer = $('.drawer');
      const md = () => ['# My founder stack', '', ...stack.map((x) => `- **${x.slot}:** ${x.name}`), '', `From ${location.origin}/`].join('\n');
      const save = () => { try { localStorage.setItem(KEY, JSON.stringify(stack)); } catch {} };
      const paint = () => {
        document.querySelectorAll('[data-count]').forEach((c) => (c.textContent = String(stack.length)));
        $('ol', drawer).innerHTML = stack.length
          ? stack.map((x) => `<li><span><b>${esc(x.name)}</b><span class="cap">${esc(x.slot)}</span></span><button type="button" data-remove="${x.slug}" aria-label="Remove ${esc(x.name)}">×</button></li>`).join('')
          : '<p class="empty">Nothing here yet. Press <b>+ Add to stack</b> on any tool.</p>';
        document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => {
          const on = stack.some((x) => x.slug === b.dataset.add);
          b.textContent = on ? '✓ In your stack' : '+ Add to stack';
          b.setAttribute('aria-pressed', String(on));
        });
      };
      const setOpen = (o: boolean) => (o ? drawer.setAttribute('data-open', '') : drawer.removeAttribute('data-open'));
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const add = t.closest<HTMLButtonElement>('[data-add]');
        if (add) {
          const i = stack.findIndex((x) => x.slug === add.dataset.add);
          i >= 0 ? stack.splice(i, 1) : stack.push({ slug: add.dataset.add!, name: add.dataset.name!, slot: add.dataset.slot! });
          save(); paint(); if (i < 0) setOpen(true);
        }
        const rm = t.closest<HTMLElement>('[data-remove]');
        if (rm) { stack = stack.filter((x) => x.slug !== rm.dataset.remove); save(); paint(); }
        if (t.closest('[data-drawer]')) setOpen(!drawer.hasAttribute('data-open'));
        if (t.closest('[data-drawer-close]')) setOpen(false);
        if (t.closest('[data-md-copy]')) navigator.clipboard?.writeText(md());
        if (t.closest('[data-md-dl]')) {
          const a = document.createElement('a');
          a.href = URL.createObjectURL(new Blob([md()], { type: 'text/markdown' }));
          a.download = 'founder-stack.md'; a.click(); URL.revokeObjectURL(a.href);
        }
        const cp = t.closest<HTMLElement>('[data-copy]');
        if (cp) navigator.clipboard?.writeText(cp.dataset.copy || '').then(() => { cp.textContent = 'Copied'; setTimeout(() => (cp.textContent = 'Copy'), 1400); });
      });
      addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      paint();
    </script>
  </body>
</html>
