---
import Brutal from '../layouts/Brutal.astro';
import Card from '../components/Card.astro';
import { meta, slots, slotsIn, shortName, tornPolygon, tearPath, topPicks } from '../lib/data.js';

const options = slots.reduce((n, s) => n + Math.max(s.candidates.length, s.alts.length + 1), 0);
const verified = slots.filter((s) => ['ok', 'fixed'].includes(s.verify?.verdict)).length;
const bySlug = Object.fromEntries(slots.map((s) => [s.slug, s]));
const featured = ['model-api-frontier-production', 'default-deploy-stack-saas-api-mcp-server', 'payments-merchant-of-record-for-software-sales', 'planning-tdd-workflow',
  'mobile-framework', 'crm', 'llm-observability-tracing', 'notes-second-brain'].map((k) => bySlug[k]).filter(Boolean);
const tickerNames = [...new Set(slots.filter((s) => ['ok', 'fixed'].includes(s.verify?.verdict)).map((s) => shortName(s.pick.name)).filter((n) => n.length <= 22))].slice(0, 28);
---
<Brutal>
  <section class="slab">
    <div class="wrap">
      <div class="top-cap cap">
        <span>Index 001<span class="sl">/</span>The AI founder's toolkit<span class="sl">/</span>Best overall + best free</span>
        <span>Checked {meta.built}<span class="sl">/</span>Any OS<span class="sl">/</span>Any country</span>
      </div>

      <h1 class="hero-h display"><span class="line"><span class="in" style="--i:0">The best tool</span></span><span class="line"><span class="in o" style="--i:1">for every job,</span></span><span class="line"><span class="in b" style="--i:2">and the free one.</span></span></h1>

      <div class="collage" aria-hidden="true">
        <div class="piece" style="--k:0;--sp:-70;left:8%;top:4%;width:46%;height:52%;transform:rotate(-5deg)">
          <div class="scrap ht" style={`clip-path:${tornPolygon('c1', 3)}`}></div>
        </div>
        <div class="piece" style="--k:1;--sp:-120;left:34%;top:0;width:52%;height:46%;transform:rotate(4deg)">
          <div class="scrap" style={`clip-path:${tornPolygon('c2')};display:flex;flex-direction:column;justify-content:space-between`}>
            <span class="cap">Best overall<span class="sl">/</span>per job</span>
            <span class="display" style="font-size:clamp(90px,11vw,170px);line-height:.8">No.1</span>
          </div>
        </div>
        <div class="piece" style="--k:2;--sp:-30;left:0;top:50%;width:44%;height:40%;transform:rotate(3deg)">
          <div class="scrap bl" style={`clip-path:${tornPolygon('c3')}`}>
            <span class="display" style="font-size:clamp(30px,3.4vw,54px);display:block">Discover<br />Build<br />Ship<br />Sell</span>
          </div>
        </div>
        <div class="piece" style="--k:3;--sp:-90;left:47%;top:52%;width:40%;height:30%;transform:rotate(-3deg)">
          <div class="scrap" style={`clip-path:${tornPolygon('c4')};position:relative`}>
            <div class="dither" style="position:absolute;inset:0 30% 0 0;opacity:.85"></div>
            <span class="cap" style="position:relative">Verified against<br />primary sources</span>
          </div>
        </div>
        <div class="piece" style="--k:4;--sp:-150;left:62%;top:78%;width:30%;height:18%;transform:rotate(6deg)">
          <div class="scrap tp" style={`clip-path:${tornPolygon('c5')}`}><span class="display" style="font-size:38px">{verified} ✓</span></div>
        </div>
        <span class="tape" style="--k:0;left:44%;top:-2%;transform:rotate(-8deg)"></span>
        <span class="tape" style="--k:1;left:4%;top:47%;transform:rotate(14deg);width:70px"></span>
      </div>

      <div class="hero-foot">
        <div class="stat"><div class="flap" data-flap={String(slots.length)}>{slots.length}</div><div class="cap">Slots, one per job</div></div>
        <div class="stat"><div class="flap" data-flap={options.toLocaleString('en')}>{options.toLocaleString('en')}</div><div class="cap">Options compared</div></div>
        <div class="stat"><div class="flap" data-flap={String(verified)}>{verified}</div><div class="cap">Picks verified</div></div>
      </div>
    </div>
  </section>
  <svg class="rip" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><path d={tearPath('hero-rip', 'bottom', 70)} /></svg>

  <div class="ticker-wrap">
    <div class="ticker" aria-hidden="true">
      <div class="track">{[...tickerNames, ...tickerNames].map((n) => <span>{n}</span>)}</div>
    </div>
    <button class="ticker-btn" type="button" data-ticker aria-pressed="false" aria-label="Pause the moving list of picks">Pause</button>
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display">The index</h2>
        <p class="cap">5 stages<span class="sl">/</span>13 tracks<span class="sl">/</span>Top picks under each track</p>
      </div>
      <div class="matrix">
        {meta.stages.map((st, i) => (
          <div class="col" id={st.key}>
            <div class="col-h"><div class="num">0{i + 1}</div><h3>{st.name}</h3><p>{st.blurb}</p></div>
            {meta.tracks.filter((t) => t.stage === st.key).map((t) => (
              <a class="cell" href={`/tracks/${t.key}/`}>
                <b>{t.name}</b>
                <span class="cap">{slotsIn(t.key).length} slots</span>
                <ul>{topPicks(t.key, 3).map((n) => <li>{n}</li>)}</ul>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display">Key picks</h2>
        <p class="cap">The decisions that shape the rest of the stack</p>
      </div>
      <div class="archive">
        {featured.map((s, i) => <Card s={s} i={i} />)}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display">Playbook</h2>
        <p class="cap">Seven phases<span class="sl">/</span>Start with 00</p>
      </div>
      <div class="rail">
        {meta.phases.map((ph, i) => (
          <a class="phase" href="/playbook/">
            <span class="n">0{i}</span>
            <h3>{ph.title}</h3>
            <span class="cap">{ph.time}<span class="sl">/</span>{ph.steps.length} steps</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Brutal>
