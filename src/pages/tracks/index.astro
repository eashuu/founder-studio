---
import Brutal from '../../layouts/Brutal.astro';
import { meta, slots, slotsIn } from '../../lib/data.js';
let n = 0;
---
<Brutal title="Tracks" description="All 13 research tracks of Founder Studio, grouped into five stages.">
  <div class="wrap page">
    <header class="ph">
      <h1 class="display">Tracks</h1>
      <div><p>Thirteen research tracks, each a stack of jobs to be done. Each job has a pick, its runners-up and every option that lost.</p><span class="cap">{meta.tracks.length} tracks<span class="sl">/</span>{slots.length} slots<span class="sl">/</span>5 stages</span></div>
    </header>
    {meta.stages.map((st, i) => (
      <section>
        <div class="stage-row"><span class="display">0{i + 1} {st.name}</span><span class="cap">{st.blurb}</span></div>
        {meta.tracks.filter((t) => t.stage === st.key).map((t) => (
          <a class="trow" href={`/tracks/${t.key}/`}>
            <span class="n">T{String(++n).padStart(2, '0')}</span>
            <span class="t">{t.name}</span>
            <p>{t.blurb}</p>
            <span class="c">{slotsIn(t.key).length}</span>
          </a>
        ))}
      </section>
    ))}
  </div>
</Brutal>
